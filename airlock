def main(argv):
    """Parse the global flags, dispatch one command, return an exit code."""
    args, root_flag, instance_flag = [], None, None
    index = 0
    while index < len(argv):
        token = argv[index]
        if token == "--root":
            index += 1
            if index >= len(argv):
                print("REFUSE: --root needs a directory", file=sys.stderr)
                return 2
            root_flag = argv[index]
        elif token == "--instance":
            index += 1
            if index >= len(argv):
                print("REFUSE: --instance needs a name", file=sys.stderr)
                return 2
            instance_flag = argv[index]
        elif token.startswith("--instance="):
            instance_flag = token.split("=", 1)[1]
        elif token in ("--help", "-h"):
            return usage()
        else:
            args.append(token)
        index += 1

    if not args:
        usage()
        return 2

    command, rest = args[0], args[1:]
    if command == "help":
        return usage()

    if root_flag is not None and not os.path.isdir(root_flag):
        print("REFUSE: --root is not a directory: %s"
              % os.path.abspath(root_flag), file=sys.stderr)
        return 2
    paths = Paths.resolve(root_flag, instance_flag)
    if not os.path.isdir(paths.root):
        print("REFUSE: no Airlock tree at %s" % paths.root,
              file=sys.stderr)
        return 2
    if not re.fullmatch(r"[A-Za-z0-9_-]+", paths.instance):
        print("REFUSE: instance name is not [A-Za-z0-9_-]+: %s"
              % paths.instance, file=sys.stderr)
        return 2

    # The one assignment that makes every container reference below name
    # THIS instance's containers.
    global INSTANCE, RUNNER, PROXY
    INSTANCE = paths.instance
    RUNNER = paths.runner
    PROXY = paths.proxy

    table = {"up": up, "down": down, "submit": submit, "status": status,
             "watch": watch, "allow": allow, "doctor": doctor}
    if command not in table:
        print("REFUSE: no such command: %s" % command, file=sys.stderr)
        print("        known: %s" % ", ".join(sorted(table)), file=sys.stderr)
        print("        airlock --help", file=sys.stderr)
        return 2
    return table[command](paths, rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
